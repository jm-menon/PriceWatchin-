server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self'; base-uri 'self'; frame-ancestors 'none'" always;

    location = /health {
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /api/site1/ { proxy_pass http://${SITE1_HOSTPORT}/; proxy_set_header Host $host; }
    location /api/site2/ { proxy_pass http://${SITE2_HOSTPORT}/; proxy_set_header Host $host; }
    location /api/site3/ { proxy_pass http://${SITE3_HOSTPORT}/; proxy_set_header Host $host; }
    location /api/site4/ { proxy_pass http://${SITE4_HOSTPORT}/; proxy_set_header Host $host; }
    location /api/site5/ { proxy_pass http://${SITE5_HOSTPORT}/; proxy_set_header Host $host; }
    location /api/tracker/ { proxy_pass http://${TRACKER_HOSTPORT}/; proxy_set_header Host $host; }

    location / { try_files $uri /index.html; }
}
